{
  "chip": "efr32mg26",
  "schema": "labwired-hw-oracle/efr32mg26-regs/v1",
  "transport": {
    "tool": "openocd-jlink",
    "openocd": "/opt/homebrew/bin/openocd",
    "interface_cfg": "interface/jlink.cfg",
    "target_cfg": "target/efm32.cfg",
    "transport_select": "swd"
  },
  "windows": [
    {
      "id": "cmu",
      "base": "0x40008000",
      "count": 32
    },
    {
      "id": "gpio",
      "base": "0x4003C000",
      "count": 32
    },
    {
      "id": "timer0",
      "base": "0x40048000",
      "count": 16
    },
    {
      "id": "timer1",
      "base": "0x4004C000",
      "count": 48
    },
    {
      "id": "usart0",
      "base": "0x400A0000",
      "count": 20
    },
    {
      "id": "iadc0",
      "base": "0x49004000",
      "count": 48
    },
    {
      "id": "i2c0",
      "base": "0x4B000000",
      "count": 20
    }
  ],
  "state_note": "reset halt, then CLKEN0 |= 0x04004630 \u2014 GPIO/TIMER0/TIMER1/USART0/I2C0/IADC0. Every other register in this oracle is still its RESET value: the preamble only un-gates the clock, it configures nothing.",
  "preamble": [
    {
      "comment": "un-gate the peripherals this oracle reads; unclocked they bus-fault the debug port",
      "write32": {
        "address": "0x40008064",
        "value": "0x04004630"
      }
    }
  ]
}
