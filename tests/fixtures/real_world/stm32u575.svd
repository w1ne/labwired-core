                    <description>LSI selected</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x2</name>
                    <description>LSE selected</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
