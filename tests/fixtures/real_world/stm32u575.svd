                  <name>B_0x0</name>
                  <description>Internal Tamper 5 event erases the backup registers and all device secrets(1).</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Internal Tamper 5 event does not erase the backup registers and device secrets(2).</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
