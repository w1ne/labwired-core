+#[test]
+fn shared_nvic_wake_dispatches_before_post_sleep_instruction() {
+    for opcode in [0xBF30, 0xBF20] {
+        for irq in [0_u32, 37] {
+            for stale_disabled_irq in [false, true] {
+                let mut bus = SystemBus::new();
+                let (mut cpu, _) = labwired_core::system::cortex_m::configure_cortex_m(&mut bus);
+                cpu.pc = 0x100;
+                cpu.sp = 0x2000_1000;
+                bus.write_u16(0x100, opcode).unwrap();
+                bus.write_u16(0x102, 0x205A).unwrap(); // post-sleep marker
+                bus.write_u32(u64::from(16 + irq) * 4, 0x201).unwrap();
+                bus.write_u16(0x200, 0x215A).unwrap(); // handler marker
+                bus.write_u8(0xE000_E400 + u64::from(irq), 0x80).unwrap();
+                let word_offset = u64::from(irq / 32) * 4;
+                let bit = 1 << (irq % 32);
+                bus.write_u32(0xE000_E100 + word_offset, bit).unwrap();
+                let mut cfg = bus.config.clone();
+                cfg.idle_fast_forward_enabled = true;
+                cpu.step(&mut bus, &[], &cfg).unwrap();
+                if stale_disabled_irq {
+                    // Disabled IRQ1 has higher priority than the live wake
+                    // source. Its stale CPU bit must not steal dispatch.
+                    bus.write_u32(0xE000_E200, 1 << 1).unwrap();
+                    cpu.set_exception_pending(17);
+                }
+                bus.write_u32(0xE000_E200 + word_offset, bit).unwrap();
+                cpu.step(&mut bus, &[], &cfg).unwrap();
+                assert_eq!(cpu.active_exception, 16 + irq);
+                assert_eq!(cpu.r0, 0);
+                cpu.step(&mut bus, &[], &cfg).unwrap();
+                assert_eq!(cpu.r1, 0x5A);
+                assert_eq!(cpu.r0, 0);
+            }
+        }
+    }
+}
