+#[cfg(feature = "jit")]
+#[test]
+fn wfi_blocks_a_warmed_native_jit_cache_until_wake() {
+    for idle_enabled in [false, true] {
+        let mut bus = SystemBus::new();
+        let mut cpu = CortexM::new();
+        bus.write_u16(0, 0xBF30).unwrap(); // WFI
+        for offset in (2..42).step_by(2) {
+            bus.write_u16(offset, 0x3001).unwrap(); // ADDS r0, #1
+        }
+        bus.write_u16(42, 0xE7EA).unwrap(); // B 2
+        cpu.pc = 2;
+        let mut cfg = bus.config.clone();
+        cfg.idle_fast_forward_enabled = idle_enabled;
+        cfg.cortex_m_jit_enabled = true;
+        cfg.cortex_m_jit_min_block_instrs = 4;
+        cfg.peripheral_tick_interval = 64;
+        cpu.step_batch(&mut bus, &[], &cfg, 8192).unwrap();
+        let runs_before = cpu.jit_stats().expect("native JIT engine").block_runs;
+        assert!(runs_before > 0, "post-WFI loop must execute compiled code");
+        let r0_before = cpu.r0;
+        // Setting the PC does not flush the warmed cache. Interpret only WFI,
+        // then enter a normal multi-instruction compiled runner window.
+        cpu.pc = 0;
+        cpu.step(&mut bus, &[], &cfg).unwrap();
+        assert_eq!(cpu.pc, 2);
+        cpu.step_batch(&mut bus, &[], &cfg, 128).unwrap();
+        let runs_after = cpu.jit_stats().unwrap().block_runs;
+        if idle_enabled {
+            assert_eq!(cpu.pc, 2);
+            assert_eq!(cpu.r0, r0_before);
+            assert_eq!(runs_after, runs_before);
+            // WFI may wake under PRIMASK without taking the interrupt. The
+            // already compiled code must remain usable after this boundary.
+            cpu.primask = true;
+            cpu.set_exception_pending(15);
+            cpu.step_batch(&mut bus, &[], &cfg, 128).unwrap();
+            assert_eq!(cpu.active_exception, 0);
+            assert!(cpu.r0 > r0_before);
+            assert!(cpu.jit_stats().unwrap().block_runs > runs_before);
+        } else {
+            assert!(cpu.r0 > r0_before, "default WFI spin behavior must remain");
+            assert!(runs_after > runs_before);
+        }
+    }
+}
