+#[test]
+fn wfi_ignores_cleared_or_disabled_external_pending_bits() {
+    for irq in [0_u32, 37] {
+        let mut bus = SystemBus::new();
+        let (mut cpu, _) = labwired_core::system::cortex_m::configure_cortex_m(&mut bus);
+        let word_offset = u64::from(irq / 32) * 4;
+        let bit = 1 << (irq % 32);
+        bus.write_u16(0, 0xBF30).unwrap();
+        bus.write_u16(2, 0x205A).unwrap(); // MOVS r0, #0x5A
+        bus.write_u32(0xE000_E100 + word_offset, bit).unwrap();
+        let mut cfg = bus.config.clone();
+        cfg.idle_fast_forward_enabled = true;
+        cpu.step(&mut bus, &[], &cfg).unwrap();
+        bus.write_u32(0xE000_E200 + word_offset, bit).unwrap();
+        cpu.set_exception_pending(16 + irq);
+        assert!(cpu.idle_fast_forward_budget(&bus).is_none());
+        bus.write_u32(0xE000_E280 + word_offset, bit).unwrap();
+        assert!(cpu.idle_fast_forward_budget(&bus).is_some());
+        bus.write_u32(0xE000_E200 + word_offset, bit).unwrap();
+        bus.write_u32(0xE000_E180 + word_offset, bit).unwrap();
+        assert!(cpu.idle_fast_forward_budget(&bus).is_some());
+        // Keep the stale CPU bit in place: controller writes, not a CPU
+        // pending import, must govern wake eligibility.
+        assert_ne!(cpu.pending_exceptions, [0; 4]);
+        cpu.step(&mut bus, &[], &cfg).unwrap();
+        assert_eq!(cpu.pc, 2);
+        assert_eq!(cpu.r0, 0);
+    }
+}
