+#[test]
+fn wfi_keeps_bus_service_running_without_fetching_the_next_instruction() {
+    use labwired_core::{AdvanceRequest, Machine};
+    use std::{
+        num::NonZeroU32,
+        sync::{atomic::AtomicU64, Arc},
+    };
+
+    for batch_cap in [1, 17] {
+        let mut bus = SystemBus::new();
+        let ticks = Arc::new(AtomicU64::new(0));
+        // The normal legacy-tick capability vetoes idle skipping. This device
+        // records service, without fabricating an interrupt to hold the core.
+        bus.add_peripheral(
+            "continuous-service",
+            0x5000_0000,
+            4,
+            None,
+            Box::new(ContinuousService(ticks.clone())),
+        );
+        let (mut cpu, _) = labwired_core::system::cortex_m::configure_cortex_m(&mut bus);
+        cpu.pc = 0x100;
+        cpu.sp = 0x2000_1000;
+        bus.write_u16(0x100, 0xBF30).unwrap(); // WFI
+        bus.write_u16(0x102, 0x205A).unwrap(); // MOVS r0, #0x5A: must stay unexecuted
+        bus.write_u16(0x104, 0xE7FE).unwrap(); // B .
+        bus.write_u32(16 * 4, 0x201).unwrap(); // IRQ0 handler
+        bus.write_u16(0x200, 0x215A).unwrap(); // MOVS r1, #0x5A
+        bus.write_u16(0x202, 0xE7FE).unwrap(); // B .
+        bus.write_u32(0xE000_E100, 1).unwrap();
+        let mut machine = Machine::new(cpu, bus);
+        machine.config.idle_fast_forward_enabled = true;
+        machine.config.peripheral_tick_interval = 1;
+        machine.advance(AdvanceRequest::single()).unwrap();
+        let before = ticks.load(Ordering::Relaxed);
+        let report = machine
+            .advance(
+                AdvanceRequest::run(Some(37)).with_batch_cap(NonZeroU32::new(batch_cap).unwrap()),
+            )
+            .unwrap();
+        assert_eq!(report.fuel_consumed, 37);
+        assert_eq!(report.idle_cycles, 0, "active service forbids a time skip");
+        assert_eq!(ticks.load(Ordering::Relaxed) - before, 37);
+        assert_eq!(machine.cpu.pc, 0x102);
+        assert_eq!(machine.cpu.r0, 0);
+        assert_eq!(machine.cpu.active_exception, 0);
+        // A subsequent controller pend must still reach ordinary exception
+        // dispatch. The handler marker distinguishes wake from false progress.
+        machine.bus.write_u32(0xE000_E200, 1).unwrap();
+        machine.advance(AdvanceRequest::run(Some(4))).unwrap();
+        assert_eq!(machine.cpu.active_exception, 16);
+        assert_eq!(machine.cpu.r1, 0x5A);
+        assert_eq!(machine.cpu.r0, 0);
+    }
+}
