+#[test]
+fn shared_nvic_wake_is_visible_before_cpu_pending_import() {
+    for opcode in [0xBF30, 0xBF20] {
+        for irq in [0_u32, 37] {
+            for (primask, basepri, faultmask, enabled, active, priority, expected_wake) in [
+                (false, 0, false, true, 0, 0x80, true),
+                (true, 0, false, true, 0, 0x80, opcode == 0xBF30),
+                (false, 0x40, false, true, 0, 0x80, false),
+                (false, 0, true, true, 0, 0x80, false),
+                (false, 0, false, false, 0, 0x80, false),
+                (false, 0, false, true, 17, 0x80, false),
+                (false, 0, false, true, 17, 0x20, true),
+            ] {
+                let mut bus = SystemBus::new();
+                let (mut cpu, _) = labwired_core::system::cortex_m::configure_cortex_m(&mut bus);
+                cpu.pc = 0x100;
+                cpu.primask = primask;
+                cpu.basepri = basepri;
+                cpu.faultmask = faultmask;
+                cpu.active_exception = active;
+                bus.write_u16(0x100, opcode).unwrap();
+                bus.write_u8(0xE000_E401, 0x40).unwrap(); // active IRQ1
+                bus.write_u8(0xE000_E400 + u64::from(irq), priority)
+                    .unwrap();
+                let mut cfg = bus.config.clone();
+                cfg.idle_fast_forward_enabled = true;
+                cpu.step(&mut bus, &[], &cfg).unwrap();
+                assert!(cpu.idle_fast_forward_budget(&bus).is_some());
+                let word_offset = u64::from(irq / 32) * 4;
+                let bit = 1 << (irq % 32);
+                if enabled {
+                    bus.write_u32(0xE000_E100 + word_offset, bit).unwrap();
+                }
+                // Host/controller writes occur before the next machine-boundary
+                // import. Do not manually fill the CPU pending bitmap here.
+                bus.write_u32(0xE000_E200 + word_offset, bit).unwrap();
+                assert_eq!(cpu.pending_exceptions, [0; 4]);
+                assert_eq!(
+                    cpu.idle_fast_forward_budget(&bus).is_none(),
+                    expected_wake,
+                    "opcode={opcode:x} irq={irq} primask={primask} basepri={basepri:x} faultmask={faultmask} enabled={enabled} active={active} priority={priority:x}"
+                );
+            }
+        }
+    }
+}
