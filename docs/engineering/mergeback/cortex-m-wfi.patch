+#[derive(Debug)]
+struct ContinuousService(std::sync::Arc<std::sync::atomic::AtomicU64>);
+
+impl labwired_core::Peripheral for ContinuousService {
+    fn read(&self, _offset: u64) -> SimResult<u8> {
+        Ok(0)
+    }
+
+    fn write(&mut self, _offset: u64, _value: u8) -> SimResult<()> {
+        Ok(())
+    }
+
+    fn tick(&mut self) -> labwired_core::PeripheralTickResult {
+        self.0.fetch_add(1, Ordering::Relaxed);
+        labwired_core::PeripheralTickResult::default()
+    }
+}
