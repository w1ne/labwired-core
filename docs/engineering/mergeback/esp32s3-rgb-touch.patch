+#[test]
+fn rgb_reset_and_mode_switch_cannot_retire_a_new_i80_transaction() {
+    use labwired_core::peripherals::components::{I80Panel, RgbPanel};
+    use labwired_core::peripherals::esp32s3::lcd_cam::Esp32s3LcdCam;
+    use labwired_core::Peripheral;
+    use std::sync::{Arc, Mutex};
+
+    #[derive(Debug, Default)]
+    struct WireSink {
+        rgb: Mutex<Vec<Vec<u16>>>,
+        i80: Mutex<Vec<(bool, u16)>>,
+    }
+    impl RgbPanel for WireSink {
+        fn rgb_frame(&self, width: u16, height: u16, pixels: &[u16]) {
+            assert_eq!((width, height), (1, 1));
+            self.rgb.lock().unwrap().push(pixels.to_vec());
+        }
+    }
+    impl I80Panel for WireSink {
+        fn i80_write_word(&self, dc_high: bool, word: u16) {
+            self.i80.lock().unwrap().push((dc_high, word));
+        }
+    }
+
+    for (prefix, reset) in [
+        (&[0x34][..], true),
+        (&[0x34, 0x12][..], true),
+        (&[0x34, 0x12][..], false),
+    ] {
+        let mut lcd = Esp32s3LcdCam::new(24);
+        let sink = Arc::new(WireSink::default());
+        assert!(lcd.attach_rgb_panel(sink.clone()));
+        lcd.attach_panel(sink.clone());
+        // A partial pixel and a completed frame both belong to the old RGB
+        // transfer. Hold its completion tick until after selecting i80.
+        lcd.write_u32(0x1c, 1 << 31).unwrap();
+        lcd.write_u32(0x14, USER).unwrap();
+        lcd.dma_arm();
+        lcd.dma_push_tx(prefix);
+        lcd.write_u32(0x1c, 0).unwrap();
+        if reset {
+            lcd.write_u32(0x14, 1 << 28).unwrap();
+            assert_eq!(
+                lcd.read_u32(0x14).unwrap() & (1 << 27),
+                0,
+                "LCD_RESET must retire the previous mode"
+            );
+            lcd.tick();
+            assert_eq!(lcd.read_u32(0x68).unwrap(), 0);
+        }
+
+        // An i80 DOUT transaction must still wait for its own payload. A
+        // stale RGB completion must not publish VSYNC or retire this start.
+        lcd.write_u32(0x18, 1 << 28).unwrap();
+        lcd.write_u32(0x14, USER).unwrap();
+        lcd.dma_arm();
+        lcd.tick();
+        assert!(
+            lcd.dma_wants_data(),
+            "new i80 DOUT must wait for its own DMA"
+        );
+        assert_eq!(lcd.read_u32(0x68).unwrap(), 0);
+        lcd.dma_push_tx(&[0xcd, 0xab]);
+        lcd.dma_finish();
+        lcd.tick();
+        assert_eq!(*sink.i80.lock().unwrap(), vec![(true, 0xabcd)]);
+        assert!(sink.rgb.lock().unwrap().is_empty());
+        assert_eq!(lcd.read_u32(0x68).unwrap(), 1 << 1);
+
+        // Switching back through reset starts a clean RGB frame, without the
+        // partial word or completion from either preceding transaction.
+        lcd.write_u32(0x1c, 1 << 31).unwrap();
+        lcd.write_u32(0x14, 1 << 28).unwrap();
+        lcd.write_u32(0x70, 0xf).unwrap();
+        lcd.write_u32(0x14, USER).unwrap();
+        lcd.dma_arm();
+        lcd.dma_push_tx(&[0x21, 0x43]);
+        lcd.dma_finish();
+        lcd.tick();
+        assert_eq!(*sink.rgb.lock().unwrap(), vec![vec![0x4321]]);
+        assert_ne!(lcd.read_u32(0x68).unwrap() & 1, 0);
+    }
+}
