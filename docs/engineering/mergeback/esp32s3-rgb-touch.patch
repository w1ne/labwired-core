+#[test]
+fn cyclic_frames_resample_memory_and_byte_bit_order_is_applied_once() {
+    let mut m = rig();
+    init_panel(&mut m);
+    mount(&mut m, 0x2104, 4092, true);
+    m.bus.write_u32(LCD + 0x14, USER | (1 << 22)).unwrap();
+    await_vsync(&mut m);
+    assert_eq!(pixel(&artifact(&m), 480), 0x3412);
+    assert_ne!(m.bus.read_u32(LCD + 0x14).unwrap() & (1 << 27), 0);
+    m.bus.write_u16(FRAME, 0x5aa5).unwrap();
+    m.bus.write_u32(LCD + 0x70, 1).unwrap();
+    await_vsync(&mut m);
+    let a = artifact(&m);
+    assert_eq!(a.meta["frames_received"], 2);
+    assert_eq!(pixel(&a, 0), 0xa55a);
+    // Change only the LCD bit-order setting while the cyclic engine runs.
+    m.bus.write_u16(FRAME, 0x1234).unwrap();
+    m.bus.write_u32(LCD + 0x14, USER | (1 << 21)).unwrap();
+    m.bus.write_u32(LCD + 0x70, 1).unwrap();
+    await_vsync(&mut m);
+    assert_eq!(pixel(&artifact(&m), 0), 0x1234u16.reverse_bits());
+    // Explicit stop prevents later ring data from making another frame.
+    m.bus.write_u32(LCD + 0x14, USER & !(1 << 27)).unwrap();
+    for _ in 0..150 {
+        m.step().unwrap();
+    }
+    assert_eq!(artifact(&m).meta["frames_received"], 3);
+}
