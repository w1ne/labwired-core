+#[test]
+fn missing_short_cpu_owned_and_wrong_format_never_complete_a_frame() {
+    for bad in [
+        "short",
+        "owner",
+        "length",
+        "8bit",
+        "no_dma",
+        "unaligned",
+        "unmapped_descriptor",
+        "unmapped_data",
+    ] {
+        let mut m = rig();
+        // The standalone S3 rig retains the default bus slab at 0x20000000.
+        // Prove these negative controls use a genuinely unmapped address.
+        assert!(m.bus.read_u8(UNMAPPED).is_err());
+        assert!(m.bus.read_u32(UNMAPPED).is_err());
+        init_panel(&mut m);
+        mount(&mut m, 0x07e0, 4092, false);
+        match bad {
+            "short" => m.bus.write_u32(DESC + 8, 0).unwrap(),
+            "owner" => {
+                let v = m.bus.read_u32(DESC).unwrap();
+                m.bus.write_u32(DESC, v & !(1 << 31)).unwrap();
+            }
+            "length" => m.bus.write_u32(DESC, (1 << 31) | (4092 << 12) | 4).unwrap(),
+            "no_dma" => m.bus.write_u32(DMA + 0x80, 1 << 20).unwrap(),
+            "unaligned" => m.bus.write_u32(DESC + 8, (DESC + 13) as u32).unwrap(),
+            "unmapped_descriptor" => m.bus.write_u32(DESC + 8, UNMAPPED as u32).unwrap(),
+            "unmapped_data" => m.bus.write_u32(DESC + 4, UNMAPPED as u32).unwrap(),
+            _ => {}
+        }
+        let user = if bad == "8bit" {
+            USER & !(1 << 23)
+        } else {
+            USER
+        };
+        m.bus.write_u32(LCD + 0x14, user).unwrap();
+        for _ in 0..160 {
+            m.step().unwrap();
+        }
+        assert_eq!(artifact(&m).meta["frames_received"], 0, "{bad}");
+        assert_eq!(m.bus.read_u32(LCD + 0x68).unwrap() & 1, 0, "{bad}");
+        if matches!(
+            bad,
+            "owner" | "length" | "unaligned" | "unmapped_descriptor" | "unmapped_data"
+        ) {
+            assert_ne!(m.bus.read_u32(DMA + 0x68).unwrap() & 4, 0);
+        }
+    }
+}
