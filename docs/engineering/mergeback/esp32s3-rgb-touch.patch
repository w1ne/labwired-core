+#[test]
+fn rgb_owner_writeback_keeps_eof_and_rejects_cpu_owned_ring_reuse() {
+    let mut m = rig();
+    init_panel(&mut m);
+    mount(&mut m, 0x2104, 4092, true);
+    // EOF can occur before the active frame ends; it is an interrupt marker,
+    // not permission to fabricate a short frame or stop a circular chain.
+    let first = m.bus.read_u32(DESC).unwrap();
+    m.bus.write_u32(DESC, first | (1 << 30)).unwrap();
+    m.bus.write_u32(DMA + 0x60, 1 << 2).unwrap();
+    m.bus.write_u32(LCD + 0x14, USER).unwrap();
+    m.step().unwrap();
+    assert_ne!(m.bus.read_u32(DMA + 0x68).unwrap() & (1 << 1), 0);
+    assert_eq!(artifact(&m).meta["frames_received"], 0);
+    await_vsync(&mut m);
+    assert_eq!(artifact(&m).meta["frames_received"], 1);
+    assert_eq!(m.bus.read_u32(DESC).unwrap() & (1 << 31), 0);
+    m.bus.write_u32(LCD + 0x70, 1).unwrap();
+    for _ in 0..150 {
+        m.step().unwrap();
+    }
+    assert_ne!(m.bus.read_u32(DMA + 0x68).unwrap() & (1 << 2), 0);
+    assert_eq!(artifact(&m).meta["frames_received"], 1);
+    assert_eq!(m.bus.read_u32(LCD + 0x68).unwrap() & 1, 0);
+}
