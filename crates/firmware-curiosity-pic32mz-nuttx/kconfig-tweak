#!/usr/bin/env python3
"""Minimal stand-in for kconfig-frontends' kconfig-tweak: the subset NuttX's
tools/sethost.sh and configure.sh call (--file, --enable, --disable,
--set-str, --set-val, --undefine). Used when kconfig-frontends is not
installed; kconfiglib (olddefconfig) does the rest."""
import re
import sys

args = sys.argv[1:]
path = ".config"
ops = []
i = 0
while i < len(args):
    a = args[i]
    if a == "--file":
        path = args[i + 1]
        i += 2
    elif a in ("--enable", "-e", "--disable", "-d", "--undefine", "-u"):
        ops.append((a.lstrip("-")[0], args[i + 1], None))
        i += 2
    elif a in ("--set-str", "--set-val"):
        ops.append((a, args[i + 1], args[i + 2]))
        i += 3
    else:
        sys.exit(f"kconfig-tweak shim: unsupported argument {a}")

lines = open(path).read().splitlines()
for op, sym, val in ops:
    if not sym.startswith("CONFIG_"):
        sym = "CONFIG_" + sym
    pat = re.compile(rf"^(# )?{re.escape(sym)}( is not set|=.*)$")
    if op == "e":
        new = f"{sym}=y"
    elif op == "d":
        new = f"# {sym} is not set"
    elif op == "u":
        new = None
    elif op == "--set-str":
        new = f'{sym}="{val}"'
    else:
        new = f"{sym}={val}"
    out, done = [], False
    for ln in lines:
        if pat.match(ln):
            if new is not None and not done:
                out.append(new)
            done = True
        else:
            out.append(ln)
    if not done and new is not None:
        out.append(new)
    lines = out
open(path, "w").write("\n".join(lines) + "\n")
