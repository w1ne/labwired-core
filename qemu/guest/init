#!/bin/sh
# PID 1 of the test initramfs (rdinit=/init). Everything it runs is from the
# Raspberry Pi OS image (busybox, i2c modules); no block device is touched,
# so the run is deterministic under -icount. Prints LW-* markers for the
# host, then reboots (QEMU -no-reboot exits).
/bin/busybox --install -s /bin
export PATH=/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
echo "LW-BEGIN kernel $(uname -r)"
insmod /lib/modules/i2c-bcm2835.ko && echo "LW-MODPROBE i2c-bcm2835 ok"
insmod /lib/modules/i2c-dev.ko && echo "LW-MODPROBE i2c-dev ok"
n=0; while [ ! -e /dev/i2c-1 ] && [ $n -lt 50 ]; do sleep 0.1; n=$((n+1)); done
echo "LW-I2C-NODES: $(ls /dev/i2c-* 2>/dev/null | tr '\n' ' ')"
for a in /sys/bus/i2c/devices/i2c-*; do
    [ -e "$a/name" ] && echo "LW-ADAPTER $(basename $a): $(cat $a/name)"
done
if [ -r /sys/kernel/debug/clk/clk_summary ]; then
    grep -E '^ *clock |vpu|i2c' /sys/kernel/debug/clk/clk_summary | sed 's/^/LW-CLK: /'
fi
f=/proc/device-tree/soc/i2c@7e804000/clock-frequency
[ -r "$f" ] && echo "LW-DT-I2C1-CLOCK-FREQUENCY: $(hexdump -e '4/1 "%02x"' "$f")"
mode=$(sed -n 's/.*lwtest=\([a-z]*\).*/\1/p' /proc/cmdline)
count=$(sed -n 's/.*lwcount=\([0-9]*\).*/\1/p' /proc/cmdline)
count=${count:-200}
echo "LW-MODE: ${mode:-single} count=$count"

# addrs BUS: the addresses i2cdetect finds on /dev/i2c-BUS, space separated
addrs() {
    i2cdetect -y "$1" > /tmp/detect$1.txt 2>&1 || true
    cat /tmp/detect$1.txt
    echo "LW-BUS$1-ADDRS: $(grep -E '^[0-7]0:' /tmp/detect$1.txt | cut -c4- \
        | tr -s ' ' '\n' | grep -vE '^(--)?$' | tr '\n' ' ')"
}

# loop BUS ADDR N: N combined transfers (write reg 0xd0, repeated start,
# read 48 bytes: ~4.6 ms of bus time each, so the two buses overlap). A
# transfer is good when it returns chip-id 0x60 first and the same 48 bytes
# as the first read.
loop() {
    ref=$(i2ctransfer -y $1 w1@$2 0xd0 r48 2>&1)
    echo "LW-REF bus$1 $2: $ref"
    ok=0; bad=0; i=0
    while [ $i -lt $3 ]; do
        v=$(i2ctransfer -y $1 w1@$2 0xd0 r48 2>&1)
        if [ "$v" = "$ref" ] && [ "${v%% *}" = 0x60 ]; then ok=$((ok+1)); else
            bad=$((bad+1)); [ $bad -le 3 ] && echo "LW-CONC-ERR bus$1 $2 #$i: $v"
        fi
        i=$((i+1))
    done
    echo "LW-CONCURRENT bus$1 $2: ok=$ok bad=$bad"
}

if [ "$mode" = dual ]; then
    for b in 1 3; do
        echo "LW-CMD: i2cdetect -y $b"
        addrs $b
    done
    for ba in "1 0x76" "3 0x77"; do
        set -- $ba
        v=$(i2cget -y $1 $2 0xd0 2>&1); rc=$?
        echo "LW-I2CGET bus$1 $2: rc=$rc out=$v"
    done
    echo "LW-CMD: concurrent i2ctransfer loops on bus 1 and bus 3"
    loop 1 0x76 $count > /tmp/c1.txt &
    loop 3 0x77 $count > /tmp/c3.txt &
    wait
    cat /tmp/c1.txt /tmp/c3.txt
    grep -h 'i2c' /proc/interrupts | sed 's/^/LW-PROC-INTERRUPTS: /'
    dmesg | grep -i 'i2c\|timed out\|timeout' | grep -v 'i2c_dev' | tail -5 | sed 's/^/LW-DMESG: /'
else
    echo "LW-CMD: i2cdetect -y 1"
    i2cdetect -y 1 > /tmp/detect.txt 2>&1 || true
    cat /tmp/detect.txt
    if grep -q '^70:.* 76' /tmp/detect.txt; then
        echo "LW-DETECT-0x76: present"
    else
        echo "LW-DETECT-0x76: absent"
    fi
    echo "LW-CMD: i2cget -y 1 0x76 0xd0"
    v=$(i2cget -y 1 0x76 0xd0 2>&1); rc=$?
    echo "LW-I2CGET: rc=$rc out=$v"
fi
echo "LW-UPTIME: $(cat /proc/uptime)"
echo "LW-END"
echo b > /proc/sysrq-trigger
sleep 5
